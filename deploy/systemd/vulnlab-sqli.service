[Unit]
Description=sqli.vulnlab.dev — intentionally vulnerable SQLi labs (Flask)
After=network.target mariadb.service
Wants=mariadb.service
Documentation=https://github.com/sampsonc/vulnlab.dev

[Service]
Type=simple
WorkingDirectory=/home/chs/vulnlab.dev

# DB credentials live here (created by scripts/bootstrap-sqli-db.sh).
EnvironmentFile=/etc/vulnlab/sqli.env

ExecStart=/home/chs/vulnlab.dev/.venv/bin/gunicorn \
    --bind 127.0.0.1:8084 \
    --workers 4 \
    --timeout 30 \
    --access-logfile - \
    --error-logfile - \
    apps.sqli.app:app
Restart=on-failure
RestartSec=2s

# Hardening
DynamicUser=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

# Network: SQLi labs need to reach MariaDB on 127.0.0.1:3306 and nothing
# else. Deny everything except loopback.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8

[Install]
WantedBy=multi-user.target
